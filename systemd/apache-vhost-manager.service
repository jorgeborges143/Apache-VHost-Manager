[Unit]
Description=Apache VHost Manager
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/apache-vhost-manager
Environment="PATH=/opt/apache-vhost-manager/venv/bin"
EnvironmentFile=/opt/apache-vhost-manager/.env
ExecStart=/opt/apache-vhost-manager/venv/bin/gunicorn -c deploy/gunicorn.conf.py "app:create_app('production')"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

