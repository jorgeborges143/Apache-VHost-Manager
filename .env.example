# Apache VHost Manager - Environment Configuration
# Copy this file to .env and update values for your environment.

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_CONFIG=production

# Admin User (created on first run if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Database
DATABASE_URL=sqlite:///apache_vhost_manager.db

# Paths (Ubuntu/Debian defaults)
SITES_AVAILABLE_DIR=/etc/apache2/sites-available
SITES_ENABLED_DIR=/etc/apache2/sites-enabled

# Backups & Logs
BACKUP_DIR=./backups/data
AUDIT_LOG_DIR=./logs

# Limits
MAX_BACKUPS_PER_VHOST=20

