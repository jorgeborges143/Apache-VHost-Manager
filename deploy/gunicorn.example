# Gunicorn configuration example for Apache VHost Manager
# Save as deploy/gunicorn.conf.py

import multiprocessing

bind = "127.0.0.1:8000"
workers = multiprocessing.cpu_count() * 2 + 1
worker_class = "sync"
worker_connections = 1000
max_requests = 1000
max_requests_jitter = 50
timeout = 30
keepalive = 2

errorlog = "-"
accesslog = "-"
loglevel = "info"

preload_app = True

